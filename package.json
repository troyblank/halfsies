{
	"name": "Halfsies",
	"version": "1.2.0",
	"packageManager": "yarn@1.22.22",
	"scripts": {
		"start": "npm run clean && npm run watch",
		"clean": "rm -rf dist && rm -rf coverage",
		"watch": "next dev",
		"build": "next build",
		"test": "npm run lint && npm run unit:once",
		"unit": "jest --watch",
		"unit:once": "jest --maxWorkers=25%",
		"lint": "tsc --noEmit && eslint src --ext .ts,.tsx && npm run sasslint",
		"sasslint": "./node_modules/sass-lint/bin/sass-lint.js -c ./node_modules/@troyblank/sasslint-config-troyblank/.sass-lint.yml './src/**/*.scss' -v -q"
	},
	"dependencies": {
		"@aws-amplify/adapter-nextjs": "1.7.3",
		"@aws-amplify/auth": "6.20.0",
		"@tanstack/react-query": "5.100.13",
		"@troyblank/eslint-config-troyblank": "2.4.0",
		"@troyblank/sasslint-config-troyblank": "1.0.0",
		"@types/chance": "1.1.8",
		"@types/jest": "30.0.0",
		"@types/node": "25.9.1",
		"@types/react": "19.2.15",
		"aws-amplify": "6.17.0",
		"chance": "1.1.13",
		"classnames": "2.5.1",
		"jest": "30.4.2",
		"jest-environment-jsdom": "30.4.1",
		"js-cookie": "3.0.7",
		"lodash": "4.18.1",
		"next": "16.2.6",
		"normalize.css": "8.0.1",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"sass": "1.99.0",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@swc/core": "1.15.33",
		"@swc/jest": "0.2.39",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1"
	},
	"author": "Troy Blank",
	"license": "BSD-3-Clause"
}
